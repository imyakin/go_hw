        "handler.UpdateBoardRequest": {
            "type": "object",
            "required": [
                "cells",
                "size"
            ],
            "properties": {
                "cells": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "size": {
                    "type": "integer",
                    "minimum": 1
                }
