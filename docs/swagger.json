        "handler.MoveResponse": {
            "type": "object",
            "properties": {
                "from_col": {
                    "type": "integer"
                },
                "from_row": {
                    "type": "integer"
                },
                "game_id": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "notation": {
                    "type": "string"
                },
                "piece": {
                    "type": "string"
                },
                "player": {
                    "type": "string"
                },
                "to_col": {
                    "type": "integer"
                },
                "to_row": {
                    "type": "integer"
                }
            }
        },
        "handler.PlayerResponse": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "symbol": {
                    "type": "string"
                }
            }
