    "definitions": {
        "handler.BoardResponse": {
            "type": "object",
            "properties": {
                "cells": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "id": {
                    "type": "integer"
                },
                "size": {
                    "type": "integer"
                }
            }
        },
        "handler.CreateBoardRequest": {
            "type": "object",
            "required": [
                "size"
            ],
            "properties": {
                "size": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "handler.CreateGameRequest": {
            "type": "object",
            "required": [
                "black_player_name",
                "board_size",
                "white_player_name"
            ],
            "properties": {
                "black_player_name": {
                    "type": "string"
                },
                "board_size": {
                    "type": "integer",
                    "minimum": 1
                },
                "white_player_name": {
                    "type": "string"
                }
            }
        },
        "handler.CreateMoveRequest": {
            "type": "object",
            "required": [
                "game_id"
            ],
            "properties": {
                "from_col": {
                    "type": "integer"
                },
                "from_row": {
                    "type": "integer"
                },
                "game_id": {
                    "type": "integer"
                },
                "notation": {
                    "description": "Alternative: chess notation like \"e2-e4\"",
                    "type": "string"
                },
                "to_col": {
                    "type": "integer"
                },
                "to_row": {
                    "type": "integer"
                }
            }
        },
        "handler.CreatePlayerRequest": {
            "type": "object",
