                        "black"
                    ]
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "handler.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "error message"
                }
            }
        },
        "handler.GameResponse": {
            "type": "object",
            "properties": {
                "black_player_name": {
                    "type": "string"
                },
                "board_size": {
                    "type": "integer"
                },
                "cells": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "current_player_color": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "status": {
                    "type": "string"
                },
                "white_player_name": {
                    "type": "string"
                },
                "winner_color": {
                    "type": "string"
                }
            }
