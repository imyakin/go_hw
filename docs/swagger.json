        "handler.UpdateGameRequest": {
            "type": "object",
            "required": [
                "black_player_name",
                "board_size",
                "status",
                "white_player_name"
            ],
            "properties": {
                "black_player_name": {
                    "type": "string"
                },
                "board_size": {
                    "type": "integer",
                    "minimum": 1
                },
                "status": {
                    "type": "string"
                },
                "white_player_name": {
                    "type": "string"
                }
            }
        },
        "handler.UpdateMoveRequest": {
            "type": "object",
            "required": [
                "from_col",
                "from_row",
                "game_id",
                "piece",
                "to_col",
                "to_row"
            ],
            "properties": {
                "from_col": {
                    "type": "integer"
                },
                "from_row": {
                    "type": "integer"
                },
                "game_id": {
                    "type": "integer"
                },
                "piece": {
                    "type": "string"
                },
                "to_col": {
                    "type": "integer"
                },
                "to_row": {
                    "type": "integer"
                }
            }
        },
        "handler.UpdatePlayerRequest": {
            "type": "object",
            "required": [
                "color",
                "name"
            ],
            "properties": {
                "color": {
                    "type": "string",
                    "enum": [
                        "white",
                        "black"
                    ]
                },
                "name": {
                    "type": "string"
                }
            }
        }
    }
